<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".CondroidApp"
        android:allowBackup="true"
        android:icon="@android:drawable/ic_dialog_dialer"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/ic_dialog_dialer"
        android:supportsRtl="true"
        android:theme="@style/Theme.Condroid"
        android:hardwareAccelerated="true">

        <!-- Main Home Screen with Layout Presets Gallery -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fullscreen Controller Gamepad Activity -->
        <activity
            android:name=".GamepadActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustNothing" />

    </application>

</manifest>
